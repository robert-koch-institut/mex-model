{
    "$$target": "/mex/model/entities/merged-variable-group#/identifier",
    "$id": "https://mex.rki.de/mex/model/entities/merged-variable-group",
    "$schema": "http://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "allOf": [
        {
            "else": {
                "properties": {
                    "containedBy": {
                        "maxItems": 0
                    },
                    "label": {
                        "maxItems": 0
                    }
                }
            },
            "if": {
                "properties": {
                    "supersededBy": {
                        "type": "null"
                    }
                }
            },
            "then": {
                "properties": {
                    "containedBy": {
                        "minItems": 1
                    },
                    "label": {
                        "minItems": 1
                    }
                },
                "required": [
                    "containedBy",
                    "label"
                ]
            }
        }
    ],
    "description": "The grouping of variables according to a certain aspect, e.g. how the information is modelled in the primary source.",
    "properties": {
        "containedBy": {
            "closeMatch": [
                "http://purl.org/dc/terms/isPartOf"
            ],
            "default": [],
            "description": "The resource that the variable group is contained by. Used to connect a variable group to its resource.",
            "items": {
                "$ref": "/mex/model/entities/merged-resource#/identifier"
            },
            "type": "array"
        },
        "identifier": {
            "$ref": "/mex/model/fields/identifier",
            "closeMatch": [
                "http://purl.org/dc/elements/1.1/identifier"
            ],
            "description": "An unambiguous reference to the resource within a given context. Persistent identifiers should be provided as HTTP URIs ([DCT, 2020-01-20](http://dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/)).",
            "readOnly": true
        },
        "label": {
            "closeMatch": [
                "http://www.w3.org/2000/01/rdf-schema#label"
            ],
            "default": [],
            "description": "The name of the variable group.",
            "items": {
                "$ref": "/mex/model/fields/text"
            },
            "type": "array"
        },
        "supersededBy": {
            "anyOf": [
                {
                    "$ref": "/mex/model/entities/merged-variable-group#/identifier"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "A merged item which is the preferred duplicate, because it replaces, consolidates or otherwise makes the current merged item obsolete."
        }
    },
    "required": [
        "identifier"
    ],
    "title": "Merged Variable Group",
    "type": "object"
}
