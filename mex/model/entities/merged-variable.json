{
    "$$target": "/mex/model/entities/merged-variable#/identifier",
    "$id": "https://mex.rki.de/mex/model/entities/merged-variable",
    "$schema": "http://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "allOf": [
        {
            "else": {
                "properties": {
                    "belongsTo": {
                        "maxItems": 0
                    },
                    "categories": {
                        "maxItems": 0
                    },
                    "datatypeInPrimarySource": {
                        "type": "null"
                    },
                    "datatypeStandardized": {
                        "type": "null"
                    },
                    "description": {
                        "maxItems": 0
                    },
                    "propertyURL": {
                        "type": "null"
                    },
                    "surveyInstrument": {
                        "maxItems": 0
                    },
                    "technicalName": {
                        "type": "null"
                    },
                    "title": {
                        "maxItems": 0
                    },
                    "usedIn": {
                        "maxItems": 0
                    }
                }
            },
            "if": {
                "properties": {
                    "supersededBy": {
                        "type": "null"
                    }
                }
            },
            "then": {
                "properties": {
                    "datatypeInPrimarySource": {
                        "not": {
                            "type": "null"
                        }
                    },
                    "technicalName": {
                        "not": {
                            "type": "null"
                        }
                    },
                    "usedIn": {
                        "minItems": 1
                    }
                },
                "required": [
                    "datatypeInPrimarySource",
                    "technicalName",
                    "usedIn"
                ]
            }
        }
    ],
    "closeMatch": [
        "http://www.w3.org/ns/csvw#Column",
        "https://datapackage.org/profiles/2.0/tableschema.json#field"
    ],
    "description": "Variables are defined for the data-based evaluation of investigations (e.g. studies). A variable is characterized by its data type (e.g. integer, string, date) and value range. The variable can be either quantitative or qualitative, i.e. the value range can take numerical or categorical values.",
    "properties": {
        "belongsTo": {
            "$comment": "This property can be regarded as inverse property of csvw:column. While csvw:column points from the table to the column, mex:belongsTo points from the variable (column) to the variable group (table).",
            "default": [],
            "description": "The variable group that the described variable is part of. Used to group variables together, depending on how they are structured in the primary source.",
            "items": {
                "$ref": "/mex/model/entities/merged-variable-group#/identifier"
            },
            "type": "array"
        },
        "categories": {
            "closeMatch": [
                "https://datapackage.org/profiles/2.0/tableschema.json#categories"
            ],
            "default": [],
            "description": "A set of predefined categories that serve as possible values for the variable.",
            "items": {
                "$ref": "/mex/model/fields/category",
                "examples": [
                    {
                        "value": "3"
                    },
                    {
                        "label": "Akute Rhinopharyngitis",
                        "value": "J00"
                    },
                    {
                        "label": "Yes",
                        "value": "1"
                    },
                    {
                        "label": "No",
                        "value": "2"
                    }
                ]
            },
            "type": "array"
        },
        "datatypeInPrimarySource": {
            "anyOf": [
                {
                    "examples": [
                        "image",
                        "int55",
                        "integer",
                        "note",
                        "number",
                        "select_one",
                        "Text"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Datatype of the variable, as defined in the original primary source system."
        },
        "datatypeStandardized": {
            "anyOf": [
                {
                    "$ref": "/mex/model/entities/concept#/identifier",
                    "examples": [
                        "https://mex.rki.de/item/datatype-standardized-1"
                    ],
                    "useScheme": "https://mex.rki.de/item/datatype-standardized"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "Standardized datatype of the variable, as defined in the controlled vocabulary.",
            "exactMatch": [
                "http://www.w3.org/ns/csvw#datatype"
            ]
        },
        "description": {
            "closeMatch": [
                "http://purl.org/dc/terms/description"
            ],
            "default": [],
            "description": "A description of the variable. How the variable is defined in the primary source.",
            "items": {
                "$ref": "/mex/model/fields/text"
            },
            "type": "array"
        },
        "identifier": {
            "$ref": "/mex/model/fields/identifier",
            "closeMatch": [
                "http://purl.org/dc/elements/1.1/identifier"
            ],
            "description": "An unambiguous reference to the resource within a given context. Persistent identifiers should be provided as HTTP URIs ([DCT, 2020-01-20](http://dublincore.org/specifications/dublin-core/dcmi-terms/2020-01-20/)).",
            "readOnly": true
        },
        "propertyURL": {
            "anyOf": [
                {
                    "examples": [
                        "https://hello-world.org",
                        "http://purl.bioontology.org/ontology/ICD10"
                    ],
                    "pattern": "^(?:(?:[^:/?#]+):)?(?://(?:[^/?#]*))?(?:[^?#]*)(?:\\?(?:[^#]*))?(?:#(?:.*))?$",
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "A URI template used to define the RDF predicate associated with the values in the column, relative to each row. The propertyUrl may point to standard, controlled vocabularies, or ontologies that define the semantic meaning of the column.",
            "exactMatch": [
                "http://www.w3.org/ns/csvw#propertyUrl"
            ]
        },
        "supersededBy": {
            "anyOf": [
                {
                    "$ref": "/mex/model/entities/merged-variable#/identifier"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "A merged item which is the preferred duplicate, because it replaces, consolidates or otherwise makes the current merged item obsolete."
        },
        "surveyInstrument": {
            "default": [],
            "description": "The survey instrument the variable derives from.",
            "items": {
                "$ref": "/mex/model/fields/text"
            },
            "type": "array"
        },
        "technicalName": {
            "anyOf": [
                {
                    "examples": [
                        "date_of_sampling",
                        "KHEfehlb",
                        "Koerpergroesse_in_cm",
                        "StateId"
                    ],
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "default": null,
            "description": "A technical name given to the variable.",
            "exactMatch": [
                "http://www.w3.org/ns/csvw#name"
            ]
        },
        "title": {
            "default": [],
            "description": "The human readable name given to the variable.",
            "exactMatch": [
                "http://www.w3.org/ns/csvw#titles"
            ],
            "items": {
                "$ref": "/mex/model/fields/text",
                "examples": [
                    {
                        "language": "de",
                        "value": "Mehrere Treppenabsätze steigen"
                    },
                    {
                        "language": "en",
                        "value": "Climb several flights of stairs"
                    }
                ]
            },
            "type": "array"
        },
        "usedIn": {
            "default": [],
            "description": "The resource that the variable is used in.",
            "items": {
                "$ref": "/mex/model/entities/merged-resource#/identifier"
            },
            "type": "array"
        }
    },
    "required": [
        "identifier"
    ],
    "title": "Merged Variable",
    "type": "object"
}