        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n\n    subgraph \&quot;mex/model\&quot;\n        direction TB\n\n        subgraph entities[\&quot;entities/\&quot;]\n            direction TB\n            E_extracted[\&quot;extracted-*.json&amp;lt;br/&amp;gt;&amp;lt;i&amp;gt;(14 entity types)&amp;lt;/i&amp;gt;\&quot;]\n            E_merged[\&quot;merged-*.json&amp;lt;br/&amp;gt;&amp;lt;i&amp;gt;(14 entity types)&amp;lt;/i&amp;gt;\&quot;]\n            E_concept[\&quot;concept.json\&quot;]\n            E_conceptScheme[\&quot;concept-scheme.json\&quot;]\n        end\n\n        subgraph fields[\&quot;fields/\&quot;]\n            F_identifier[\&quot;identifier.json\&quot;]\n            F_link[\&quot;link.json\&quot;]\n            F_text[\&quot;text.json\&quot;]\n        end\n\n        subgraph vocabularies[\&quot;vocabularies/\&quot;]\n            V_schemes[\&quot;concept-schemes.json&amp;lt;br/&amp;gt;&amp;lt;i&amp;gt;(enumerates schemes)&amp;lt;/i&amp;gt;\&quot;]\n            V_rest[\&quot;activity-type.json&amp;lt;br/&amp;gt;theme.json&amp;lt;br/&amp;gt;language.json&amp;lt;br/&amp;gt;… (20 more files)\&quot;]\n        end\n\n        subgraph i18n[\&quot;i18n/\&quot;]\n            I_de[\&quot;de.po\&quot;]\n            I_en[\&quot;en.po\&quot;]\n        end\n\n        subgraph extension[\&quot;extension/\&quot;]\n            EX[\&quot;definition.json\&quot;]\n        end\n    end\n\n    %% Entities → Fields via $ref\n    E_extracted -- \&quot;$ref: /mex/model/fields/{text,link,identifier}\&quot; --&gt; fields\n\n    %% Entities reference other merged entities via $ref\n    E_extracted -- \&quot;$ref: merged-*#/identifier&lt;br/&gt;&lt;i&gt;(inter-entity links)&lt;/i&gt;\&quot; --&gt; E_merged\n\n    %% Vocabulary-typed fields point to concept#/identifier + useScheme\n    E_extracted -- \&quot;$ref: concept#/identifier&lt;br/&gt;+ useScheme: …/{scheme}\&quot; --&gt; E_concept\n\n    %% Concept → ConceptScheme via required inScheme\n    E_concept -- \&quot;$ref: concept-scheme#/identifier&lt;br/&gt;&lt;i&gt;(required inScheme)&lt;/i&gt;\&quot; --&gt; E_conceptScheme\n\n    %% ConceptScheme uses field types too\n    E_conceptScheme -- \&quot;$ref: fields/text&lt;br/&gt;&lt;i&gt;(label, description)&lt;/i&gt;\&quot; --&gt; fields\n\n    %% vocabularies/concept-schemes.json enumerates known schemes\n    V_schemes -. \&quot;enumerates known&lt;br/&gt;scheme identifiers\&quot; .-&gt; E_conceptScheme\n\n    %% Other vocabulary files contain concept instances\n    V_rest -. \&quot;concept instances&lt;br/&gt;belonging to schemes\&quot; .-&gt; E_concept\n\n    %% i18n labels entities &amp; fields\n    i18n -. \&quot;labels for entity&lt;br/&gt;&amp; field names\&quot; .-&gt; entities\n    i18n -. \&quot;labels for&lt;br/&gt;field names\&quot; .-&gt; fields\n\n    %% extension adds display metadata to entities\n    extension -. \&quot;display order,&lt;br/&gt;grouping metadata\&quot; .-&gt; entities&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LdyVAlllH27z6xx-KXsF-1">
